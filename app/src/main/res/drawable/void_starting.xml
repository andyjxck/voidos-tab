<?xml version="1.0" encoding="utf-8"?>
<!-- 2.0.4: VoidOS's starting window: the still "void" logo the boot animation ends on (panel-sized,
     nodpi), on the VoidOS background, so the hand-over from the boot animation shows no flat screen -->
