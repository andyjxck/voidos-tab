<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoidOS" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:colorBackground">@color/void_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
    <!-- 2.0.4: MainActivity's starting window shows the still logo; onCreate swaps to Theme.VoidOS -->
    <style name="Theme.VoidOS.Starting" parent="Theme.VoidOS">
        <item name="android:windowBackground">@drawable/void_starting</item>
    </style>
    <!-- BootCover: no starting window, no animation; it normally never draws -->
    <style name="Theme.VoidOS.BootCover" parent="Theme.VoidOS">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <!-- PowerHoldActivity: never seen, it opens the power menu and finishes -->
    <style name="Theme.VoidOS.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <color name="void_bg">#FF0B0B0D</color>
    <string name="app_name">VoidOS</string>
    <string name="void_keys_desc">Shows the VoidOS volume sliders, power menu and PIN pad in place of Android\'s.</string>
    <string name="admin_label">VoidOS device control</string>
    <string name="admin_desc">Lets VoidOS run this tablet as its home screen, hide extras and keep updates away.</string>
</resources>
